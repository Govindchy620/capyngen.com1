{
  "rewrites": [
    { "source": "/(.*)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "build": {
    "env": {
      "NPM_FLAGS": "--legacy-peer-deps"
    }
  },
  "headers": [
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|svg|gif|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
