# Loaded only by `vite dev` (not by production builds).
# Point the recruitment API at the local backend so the dynamic /fields
# endpoint is reachable during development. Production uses the default
# (https://api.orinite.com/api/v1/public/recruitment) baked into the code.
VITE_RECRUITMENT_API_BASE=http://localhost:3000/api/v1/public/recruitment
