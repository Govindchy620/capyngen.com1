# Loaded only by `vite dev` (not by production builds).
# The public recruitment API (https://api.orinite.com/api/v1/public/recruitment)
# now serves the /fields endpoint without a token, so dev uses the same default
# baked into src/services/recruitmentApi.js. Uncomment to point at a local
# backend instead:
# VITE_RECRUITMENT_API_BASE=http://localhost:3000/api/v1/public/recruitment
